{
    // Oric / OSDK debugging — generated by "Oric: Set Up Project for Debugging".
    //
    // Uses "launchScript": the extension runs the project's osdk_execute.bat with the
    // GDB port and entry breakpoint injected via the environment, so Oricutron loads the
    // program the OSDK way. This ONE path handles both media types automatically — it
    // uses whatever osdk_config.bat selects (OSDKDISK set = disk / auto-boot, otherwise
    // tape / auto-CLOAD) — so there is nothing to configure per project for tape vs disk.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "oric-debug",
            "request": "launch",
            "name": "Build & Debug (Oric)",
            "launchScript": "osdk_execute.bat",
            "cwd": "${workspaceFolder}",
            // Extended symbols emitted by the build. Single-module default; multi-module
            // projects usually use build/symbols_ext_combined instead.
            "symbolFile": "${workspaceFolder}/build/symbols_ext",
            // Halt at the program entry (OSDKADDR from osdk_config.bat)?
            // false = run to your first breakpoint. The extension auto-picks a free GDB port.
            "stopOnEntry": false,
            // Rebuild before launching whenever a source/build file changed. The built
            // artifact under build/ is auto-detected — no need to name it here.
            "build": {
                "command": "osdk_build.bat",
                "cwd": "${workspaceFolder}",
                "sources": ["${workspaceFolder}"],
                "extensions": ["c", "s", "h", "asm", "bat"],
                "exclude": [".git", "build", "node_modules"]
            }
        },
        {
            "type": "oric-debug",
            "request": "attach",
            "name": "Attach to Oricutron",
            "host": "localhost",
            // Match SET OSDKGDBPORT in osdk_config.bat if you set one.
            "port": 6502,
            "symbolFile": "${workspaceFolder}/build/symbols_ext"
        }
    ]
}
