                "title": "Oric: XA Quick Reference"
            },
            {
                "command": "osdk.6502Reference",
                "title": "Oric: 6502 Opcode Reference"
            }
        ],
        "keybindings": [
            {
                "command": "oric-debug.skipInstruction",
                "key": "ctrl+shift+f12",
                "when": "debugType == 'oric-debug' && debugState == 'stopped'"
            },
            {
                "command": "oric-debug.toggleWarp",
                "key": "ctrl+shift+f6",
                "when": "debugType == 'oric-debug'"
            },
            {
                "command": "oric-debug.resetCycleCounter",
                "key": "ctrl+shift+f9",
                "when": "debugType == 'oric-debug' && debugState == 'stopped'"
            },
            {
                "command": "oric-debug.showCurrentLocation",
                "key": "ctrl+alt+home",
                "when": "debugType == 'oric-debug' && debugState == 'stopped'"
            },
            {
                "command": "oric-debug.stepOverInstruction",
                "key": "f10",
                "when": "oricInstructionStepMode && debugType == 'oric-debug' && debugState == 'stopped'"
            },
            {
                "command": "oric-debug.stepIntoInstruction",
                "key": "f11",
                "when": "oricInstructionStepMode && debugType == 'oric-debug' && debugState == 'stopped'"
            },
            {
                "command": "oric-debug.replayRewind",
                "key": "shift+f10",
                "when": "debugType == 'oric-debug' && debugState == 'stopped' && oric-debug.canRewind"
            },
            {
                "command": "oric-debug.replayForward",
                "key": "shift+f12",
                "when": "debugType == 'oric-debug' && debugState == 'stopped' && oric-debug.canReplayForward"
            }
        ],
        "menus": {
            "view/title": [
                { "command": "oric-debug.addWatchpoint", "when": "view == oricBreakpoints", "group": "navigation@0" },
                { "command": "oric-debug.bpEnableAll", "when": "view == oricBreakpoints", "group": "navigation@1" },
                { "command": "oric-debug.bpDisableAll", "when": "view == oricBreakpoints", "group": "navigation@2" },
                { "command": "oric-debug.bpRemoveAll", "when": "view == oricBreakpoints", "group": "navigation@3" },
                { "command": "oric-debug.snapshotSave", "when": "view == oricSnapshots", "group": "navigation@1" },
                { "command": "oric-debug.snapshotRefresh", "when": "view == oricSnapshots", "group": "navigation@2" },
                { "command": "oric-debug.snapshotOpenFolder", "when": "view == oricSnapshots", "group": "navigation@3" },
                { "command": "oric-debug.stopAutomationScript", "when": "view == oricAutomation && oric-debug.automationRunning", "group": "navigation@1" },
                { "command": "oric-debug.automationRefresh", "when": "view == oricAutomation", "group": "navigation@2" },
                { "command": "oric-debug.automationOpenFolder", "when": "view == oricAutomation", "group": "navigation@3" }
            ],
            "view/item/context": [
                { "command": "oric-debug.snapshotRestoreItem", "when": "view == oricSnapshots && viewItem == oricSnap", "group": "inline@1" },
                { "command": "oric-debug.snapshotRenameItem", "when": "view == oricSnapshots && viewItem == oricSnap", "group": "inline@2" },
                { "command": "oric-debug.snapshotDeleteItem", "when": "view == oricSnapshots && viewItem == oricSnap", "group": "inline@3" },
                { "command": "oric-debug.snapshotRestoreItem", "when": "view == oricSnapshots && viewItem == oricSnap", "group": "1_snap@1" },
                { "command": "oric-debug.snapshotRenameItem", "when": "view == oricSnapshots && viewItem == oricSnap", "group": "1_snap@2" },
                { "command": "oric-debug.snapshotDeleteItem", "when": "view == oricSnapshots && viewItem == oricSnap", "group": "1_snap@3" },
                { "command": "oric-debug.automationRunItem", "when": "view == oricAutomation && viewItem == oricAutoScript", "group": "inline@1" },
                { "command": "oric-debug.automationOpenItem", "when": "view == oricAutomation && viewItem == oricAutoScript", "group": "inline@2" },
                { "command": "oric-debug.automationRunItem", "when": "view == oricAutomation && viewItem == oricAutoScript", "group": "1_auto@1" },
                { "command": "oric-debug.automationOpenItem", "when": "view == oricAutomation && viewItem == oricAutoScript", "group": "1_auto@2" },
                { "command": "oric-debug.bpEnableModule", "when": "view == oricBreakpoints && viewItem == oricModule", "group": "inline@1" },
                { "command": "oric-debug.bpDisableModule", "when": "view == oricBreakpoints && viewItem == oricModule", "group": "inline@2" },
                { "command": "oric-debug.bpEnableModule", "when": "view == oricBreakpoints && viewItem == oricModule", "group": "1_mod@1" },
                { "command": "oric-debug.bpDisableModule", "when": "view == oricBreakpoints && viewItem == oricModule", "group": "1_mod@2" },
                { "command": "oric-debug.bpRemoveModule", "when": "view == oricBreakpoints && viewItem == oricModule", "group": "inline@3" },
                { "command": "oric-debug.bpRemoveModule", "when": "view == oricBreakpoints && viewItem == oricModule", "group": "1_mod@3" },
                { "command": "oric-debug.bpEnableFile", "when": "view == oricBreakpoints && viewItem == oricFile", "group": "inline@1" },
                { "command": "oric-debug.bpDisableFile", "when": "view == oricBreakpoints && viewItem == oricFile", "group": "inline@2" },
                { "command": "oric-debug.bpEnableFile", "when": "view == oricBreakpoints && viewItem == oricFile", "group": "1_mod@1" },
                { "command": "oric-debug.bpDisableFile", "when": "view == oricBreakpoints && viewItem == oricFile", "group": "1_mod@2" },
                { "command": "oric-debug.bpRemoveFile", "when": "view == oricBreakpoints && viewItem == oricFile", "group": "inline@3" },
                { "command": "oric-debug.bpRemoveFile", "when": "view == oricBreakpoints && viewItem == oricFile", "group": "1_mod@3" },
                { "command": "oric-debug.bpEdit", "when": "view == oricBreakpoints && viewItem == oricBp", "group": "inline@1" },
                { "command": "oric-debug.bpRemove", "when": "view == oricBreakpoints && viewItem == oricBp", "group": "inline@2" },
                { "command": "oric-debug.bpEdit", "when": "view == oricBreakpoints && viewItem == oricBp", "group": "1_bp@1" },
                { "command": "oric-debug.bpRemove", "when": "view == oricBreakpoints && viewItem == oricBp", "group": "1_bp@2" },
                { "command": "oric-debug.bpEditDetail", "when": "view == oricBreakpoints && viewItem == oricBpDetail", "group": "inline@1" },
                { "command": "oric-debug.addWatchpoint", "when": "view == oricBreakpoints && viewItem == oricWatchGroup", "group": "inline@1" },
                { "command": "oric-debug.editWatchpoint", "when": "view == oricBreakpoints && viewItem == oricWatchBp", "group": "inline@1" },
                { "command": "oric-debug.removeWatchpoint", "when": "view == oricBreakpoints && viewItem == oricWatchBp", "group": "inline@2" },
                { "command": "oric-debug.editWatchpoint", "when": "view == oricBreakpoints && viewItem == oricWatchBp", "group": "1_wp@1" },
                { "command": "oric-debug.removeWatchpoint", "when": "view == oricBreakpoints && viewItem == oricWatchBp", "group": "1_wp@2" },
                { "command": "oric-debug.editWatchProp", "when": "view == oricBreakpoints && viewItem == oricWatchDetail", "group": "inline@1" },
                { "command": "oric-debug.editWatchProp", "when": "view == oricBreakpoints && viewItem == oricWatchDetail", "group": "1_wd@1" }
            ],
            "debug/toolBar": [
                {
                    "command": "oric-debug.replayRewind",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                },
                {
                    "command": "oric-debug.replayForward",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                },
                {
                    "command": "oric-debug.replayToHead",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                },
                {
                    "command": "oric-debug.skipInstruction",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                },
                {
                    "command": "oric-debug.warpOn",
                    "when": "debugType == 'oric-debug' && !oric-debug.warp"
                },
                {
                    "command": "oric-debug.warpOff",
                    "when": "debugType == 'oric-debug' && oric-debug.warp"
                },
                {
                    "command": "oric-debug.resetCycleCounter",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                },
                {
                    "command": "oric-debug.showCurrentLocation",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                },
                {
                    "command": "oric-debug.turboRunToCursor",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                }
            ],
            "editor/lineNumber/context": [
                {
                    "command": "oric-debug.runToLine",
                    "group": "oric@1",
                    "when": "inDebugMode && debugType == 'oric-debug' && debugState == 'stopped' && resourceScheme == 'file' && editorLineNumber not in oric-debug.pcEditorLines"
                },
                {
                    "command": "oric-debug.turboRunToLine",
                    "group": "oric@2",
                    "when": "inDebugMode && debugType == 'oric-debug' && debugState == 'stopped' && resourceScheme == 'file' && editorLineNumber not in oric-debug.pcEditorLines"
                },
                {
                    "command": "oric-debug.jumpToLine",
                    "group": "oric@3",
                    "when": "inDebugMode && debugType == 'oric-debug' && debugState == 'stopped' && resourceScheme == 'file' && editorLineNumber not in oric-debug.pcEditorLines"
                },
                {
                    "command": "oric-debug.skipLine",
                    "group": "oric@4",
                    "when": "inDebugMode && debugType == 'oric-debug' && debugState == 'stopped' && resourceScheme == 'file' && editorLineNumber in oric-debug.pcEditorLines"
                },
                {
                    "command": "oric-debug.copyLine",
                    "group": "oric@5",
                    "when": "inDebugMode && debugType == 'oric-debug' && resourceScheme == 'file'"
                }
            ],
            "commandPalette": [
                {
                    "command": "oric-debug.bpEnableModule",
                    "when": "false"
                },
                {
                    "command": "oric-debug.bpDisableModule",
                    "when": "false"
                },
                {
                    "command": "oric-debug.bpEnableFile",
                    "when": "false"
                },
                {
                    "command": "oric-debug.bpDisableFile",
                    "when": "false"
                },
                {
                    "command": "oric-debug.runToLine",
                    "when": "false"
                },
                {
                    "command": "oric-debug.turboRunToLine",
                    "when": "false"
                },
                {
                    "command": "oric-debug.jumpToLine",
                    "when": "false"
                },
                {
                    "command": "oric-debug.skipLine",
                    "when": "false"
                },
                {
                    "command": "oric-debug.replayRewind",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                },
                {
                    "command": "oric-debug.replayForward",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                },
                {
                    "command": "oric-debug.replayToHead",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                },
                { "command": "oric-debug.bpEdit", "when": "false" },
                { "command": "oric-debug.bpEditDetail", "when": "false" },
                { "command": "oric-debug.bpRemove", "when": "false" },
                { "command": "oric-debug.bpRemoveFile", "when": "false" },
                { "command": "oric-debug.bpRemoveModule", "when": "false" },
                { "command": "oric-debug.editWatchpoint", "when": "false" },
                { "command": "oric-debug.removeWatchpoint", "when": "false" },
                { "command": "oric-debug.editWatchProp", "when": "false" },
                { "command": "oric-debug.snapshotRestoreItem", "when": "false" },
                { "command": "oric-debug.snapshotDeleteItem", "when": "false" },
                { "command": "oric-debug.snapshotRenameItem", "when": "false" },
                { "command": "oric-debug.automationRunItem", "when": "false" },
                { "command": "oric-debug.automationOpenItem", "when": "false" }
            ]
        },
        "debuggers": [
            {
                "type": "oric-debug",
                "label": "Oric Debug",
                "program": "./debug_adapter.js",
                "runtime": "node",
                "configurationAttributes": {
                    "attach": {
                        "required": ["port"],
                        "properties": {
                            "host": {
                                "type": "string",
                                "description": "Hostname of the Oricutron GDB stub",
                                "default": "localhost"
                            },
                            "port": {
                                "type": "number",
                                "description": "TCP port of the Oricutron GDB stub",
                                "default": 6502
                            },
                            "symbolFile": {
                                "type": "string",
                                "description": "Path to symbol file (HHHH symbol_name per line)"
                            },
                            "stopOnAttach": {
                                "type": "boolean",
                                "description": "Break on attach",
                                "default": true
                            },
                            "logLevel": {
                                "type": "number",
                                "description": "Debug log verbosity: 0=errors, 1=normal, 2=verbose",
                                "default": 1
                            }
                        }
                    },
                    "launch": {
                        "properties": {
                            "launchScript": {
                                "type": "string",
                                "description": "Path to an OSDK launch script (e.g. osdk_debug.bat) that builds and starts the emulator with the GDB stub. The recommended \"OSDK way\" — an alternative to emulatorPath+diskImage. When set, cwd/build.cwd is used as its working directory."
                            },
                            "cwd": {
                                "type": "string",
                                "description": "Working directory for the launch script and build command (defaults to build.cwd, then the process cwd). Distinct from emulatorCwd, which is the emulator's own working directory."
                            },
                            "emulatorPath": {
                                "type": "string",
                                "description": "Path to Oricutron executable (used when launchScript is not set)"
                            },
                            "emulatorArgs": {
                                "type": "array",
                                "items": { "type": "string" },
                                "description": "Additional emulator arguments",
                                "default": []
                            },
                            "diskImage": {
                                "type": "string",
                                "description": "Disk image to load (.dsk or .tap). Optional: if unset, the newest .dsk under build/ is auto-detected (else newest .tap). Tape projects with no diskImage are loaded via the launch script."
                            },
                            "emulatorCwd": {
                                "type": "string",
                                "description": "Working directory for emulator (defaults to emulator's directory)"
                            },
                            "host": {
                                "type": "string",
                                "description": "Hostname for GDB connection",
                                "default": "localhost"
                            },
                            "port": {
                                "type": "number",
                                "description": "TCP port for Oricutron GDB stub",
                                "default": 6502
                            },
                            "symbolFile": {
                                "type": "string",
                                "description": "Path to symbol file (HHHH symbol_name per line)"
                            },
                            "stopOnAttach": {
                                "type": "boolean",
                                "description": "Break on attach",
                                "default": true
                            },
                            "logLevel": {
                                "type": "number",
                                "description": "Debug log verbosity: 0=errors, 1=normal, 2=verbose",
                                "default": 1
                            },
                            "turboRunTo": {
                                "type": "string",
                                "description": "Symbol to warp (max-speed) fast-forward to on launch, e.g. a game or module entry label"
                            },
                            "build": {
                                "type": "object",
                                "description": "Optional build configuration (staleness check + build)",
                                "properties": {
                                    "command": {
                                        "type": "string",
                                        "description": "Build command (e.g. osdk_build.bat)"
                                    },
                                    "cwd": {
                                        "type": "string",
                                        "description": "Working directory for build command"
                                    },
                                    "output": {
                                        "type": "string",
                                        "description": "Build output file to check for staleness. Optional: if unset (and no diskImage), the newest .dsk under build/ is auto-detected, else the newest .tap."
                                    },
                                    "sources": {
                                        "type": "array",
                                        "items": { "type": "string" },
                                        "description": "Source files/directories to check for staleness (typically under ${workspaceFolder}). Pair with extensions/exclude to filter a whole workspace to just source files."
                                    },
                                    "extensions": {
                                        "type": "array",
                                        "items": { "type": "string" },
                                        "description": "If set, only files with these extensions (no leading dot, e.g. [\"c\",\"s\",\"h\",\"asm\"]) count when checking staleness."
                                    },
                                    "exclude": {
                                        "type": "array",
                                        "items": { "type": "string" },
                                        "description": "Directory names to skip during the staleness walk (e.g. [\".git\",\"build\",\"node_modules\"]). Matched against any path segment."
                                    }
                                }
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "oric-debug",
                        "request": "launch",
                        "name": "Build & Debug",
                        "emulatorPath": "${env:OSDK}/Oricutron/Oricutron.exe",
                        "diskImage": "${workspaceFolder}/build/program.dsk",
                        "port": 6502,
                        "symbolFile": "${workspaceFolder}/build/symbols",
                        "stopOnAttach": true,
                        "build": {
                            "command": "osdk_build.bat",
                            "cwd": "${workspaceFolder}",
                            "output": "${workspaceFolder}/build/program.dsk",
                            "sources": ["${workspaceFolder}/code"]
                        }
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "Oric Debug: Build & Launch",
                        "description": "Build if stale, launch Oricutron, and attach debugger",
                        "body": {
                            "type": "oric-debug",
                            "request": "launch",
                            "name": "Build & Debug",
                            "emulatorPath": "^\"\\${env:OSDK}/Oricutron/Oricutron.exe\"",
                            "diskImage": "^\"\\${workspaceFolder}/build/${1:program}.dsk\"",
                            "port": 6502,
                            "symbolFile": "^\"\\${workspaceFolder}/build/symbols\"",
                            "stopOnAttach": true,
                            "build": {
                                "command": "osdk_build.bat",
                                "cwd": "^\"\\${workspaceFolder}\"",
                                "output": "^\"\\${workspaceFolder}/build/${1:program}.dsk\"",
                                "sources": ["^\"\\${workspaceFolder}/code\""]
                            }
                        }
                    },
                    {
                        "label": "Oric Debug: Attach",
                        "description": "Attach to a running Oricutron instance with GDB stub enabled",
                        "body": {
                            "type": "oric-debug",
                            "request": "attach",
                            "name": "Attach to Oricutron",
                            "host": "localhost",
                            "port": 6502,
                            "symbolFile": "^\"\\${workspaceFolder}/build/symbols\"",
                            "stopOnAttach": true
                        }
                    }
                ]
            }
        ]
    }
}
