{
    "name": "osdk-debug",
    "displayName": "OSDK",
    "description": "Oric Software Development Kit - 6502/XA assembly highlighting and Oricutron debugging",
    "version": "0.0.11",
    "publisher": "dbug",
    "icon": "images/oric-icon.png",
    "homepage": "https://osdk.org",
    "repository": {
        "type": "git",
        "url": "https://github.com/Oric-Software-Development-Kit/vscode-osdk"
    },
    "bugs": {
        "url": "https://github.com/Oric-Software-Development-Kit/vscode-osdk/issues"
    },
    "engines": {
        "vscode": "^1.64.0"
    },
    "categories": [
        "Debuggers",
        "Programming Languages"
    ],
    "keywords": [
        "osdk",
        "6502",
        "65C02",
        "oric",
        "oricutron"
    ],
    "activationEvents": [
        "onDebugResolve:oric-debug",
        "onLanguage:osdk",
        "onCommand:osdk.xaReference",
        "onCommand:osdk.6502Reference",
        "onCommand:oric-debug.openScreenView",
        "onCommand:oric-debug.openSymbols",
        "onCommand:oric-debug.showCurrentLocation",
        "onWebviewPanel:oricHeatmap",
        "onWebviewPanel:oricScreenView",
        "onWebviewPanel:oricSymbols",
        "onWebviewPanel:oricDisassembly"
    ],
    "main": "./extension.js",
    "configurationDefaults": {
        "files.associations": {
            "*.s": "osdk",
            "*.asm": "osdk"
        },
        "cSpell.words": [
            "ACIA", "Arkos", "Atmos",
            "endif", "elif", "elseif", "ifdef", "ifndef", "undef",
            "Chema", "Cumana", "Cumulus",
            "Defence", "DDENS", "DDRA", "DDRB", "DRQ",
            "EPROM", "Erebus", "Euphoric",
            "HIRES", "INTRQ", "IRQ",
            "Jasmin", "Loci", "LORES",
            "Microdisc", "NMI", "NOTRDY",
            "ORA2", "ORB", "Oric", "Oricutron", "osdk", "OSDK",
            "PCR", "PSG", "ROMDIS", "RST",
            "Sedoric", "Stratsed",
            "Telestrat", "Twilight",
            "VIA", "WRPROT", "WRTERR"
        ]
    },
    "contributes": {
        "configuration": {
            "title": "Oric Debug",
            "properties": {
                "oric-debug.showBinary": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show the %binary column in decoded values (e.g. $02|2|%00000010). Turn off for a compact $02|2. Applies live to a running debug session."
                },
                "oric-debug.breakpointsFollowActiveModule": {
                    "type": "boolean",
                    "default": true,
                    "description": "In the Oric Breakpoints panel, expand the active overlay module's section and collapse the others as the active module changes. The active module is always highlighted regardless of this setting."
                }
            }
        },
        "languages": [
            {
                "id": "osdk",
                "aliases": ["OSDK"],
                "extensions": [".asm", ".s"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "osdk",
                "scopeName": "source.asm.6502_65816.osdk",
                "path": "./syntaxes/osdk.tmLanguage.json"
            }
        ],
        "breakpoints": [
            { "language": "osdk" }
        ],
        "viewsContainers": {
            "panel": [
                {
                    "id": "oricDebugPanel",
                    "title": "Oric Debug",
                    "icon": "images/oric-icon.png"
                }
            ]
        },
        "views": {
            "debug": [
                {
                    "id": "oricDebugControls",
                    "name": "Oric Debug Controls",
                    "type": "webview"
                },
                {
                    "id": "oricCpuRegs",
                    "name": "Oric Registers",
                    "type": "webview"
                },
                {
                    "id": "oricPeripherals",
                    "name": "Oric Peripherals",
                    "type": "webview"
                },
                {
                    "id": "oricBreakpoints",
                    "name": "Oric Breakpoints"
                },
                {
                    "id": "oricSnapshots",
                    "name": "Oric Snapshots"
                }
            ],
            "oricDebugPanel": [
                {
                    "id": "oricCurrentInstr",
                    "name": "Current Instruction",
                    "type": "webview",
                    "when": "inDebugMode && debugType == 'oric-debug'"
                }
            ]
        },
        "commands": [
            {
                "command": "oric-debug.bpEnableAll",
                "title": "Oric: Enable All Breakpoints",
                "icon": "$(check-all)"
            },
            {
                "command": "oric-debug.bpDisableAll",
                "title": "Oric: Disable All Breakpoints",
                "icon": "$(circle-slash)"
            },
            {
                "command": "oric-debug.bpEnableModule",
                "title": "Oric: Enable Module Breakpoints",
                "icon": "$(check)"
            },
            {
                "command": "oric-debug.bpDisableModule",
                "title": "Oric: Disable Module Breakpoints",
                "icon": "$(circle-slash)"
            },
            {
                "command": "oric-debug.bpEnableFile",
                "title": "Oric: Enable File Breakpoints",
                "icon": "$(check)"
            },
            {
                "command": "oric-debug.bpDisableFile",
                "title": "Oric: Disable File Breakpoints",
                "icon": "$(circle-slash)"
            },
            {
                "command": "oric-debug.bpEdit",
                "title": "Oric: Edit Breakpoint…",
                "icon": "$(edit)"
            },
            {
                "command": "oric-debug.bpEditDetail",
                "title": "Oric: Edit",
                "icon": "$(edit)"
            },
            {
                "command": "oric-debug.bpRemove",
                "title": "Oric: Remove Breakpoint",
                "icon": "$(trash)"
            },
            {
                "command": "oric-debug.snapshotSave",
                "title": "Oric: Save Snapshot",
                "icon": "$(save)"
            },
            {
                "command": "oric-debug.snapshotRestore",
                "title": "Oric: Restore Snapshot",
                "icon": "$(history)"
            },
            {
                "command": "oric-debug.snapshotRestartRecent",
                "title": "Oric: Restart to Most Recent Snapshot",
                "icon": "$(debug-restart)"
            },
            {
                "command": "oric-debug.snapshotDelete",
                "title": "Oric: Delete Snapshot"
            },
            {
                "command": "oric-debug.snapshotRefresh",
                "title": "Oric: Refresh Snapshots",
                "icon": "$(refresh)"
            },
            {
                "command": "oric-debug.snapshotRestoreItem",
                "title": "Restore",
                "icon": "$(history)"
            },
            {
                "command": "oric-debug.snapshotDeleteItem",
                "title": "Delete",
                "icon": "$(trash)"
            },
            {
                "command": "oric-debug.snapshotRenameItem",
                "title": "Rename",
                "icon": "$(edit)"
            },
            {
                "command": "oric-debug.openMemoryView",
                "title": "Oric: Memory View"
            },
            {
                "command": "oric-debug.openHeatmap",
                "title": "Oric: Memory Heatmap"
            },
            {
                "command": "oric-debug.skipInstruction",
                "title": "Oric: Skip Instruction",
                "icon": "$(debug-step-over)"
            },
            {
                "command": "oric-debug.toggleWarp",
                "title": "Oric: Toggle Warp Speed",
                "icon": "$(rocket)"
            },
            {
                "command": "oric-debug.warpOn",
                "title": "Oric: Enable Warp Speed",
                "icon": "$(watch)"
            },
            {
                "command": "oric-debug.warpOff",
                "title": "Oric: Disable Warp Speed",
                "icon": "$(rocket)"
            },
            {
                "command": "oric-debug.resetCycleCounter",
                "title": "Oric: Reset Cycle Counter",
                "icon": "$(history)"
            },
            {
                "command": "oric-debug.openScreenView",
                "title": "Oric: Screen View"
            },
            {
                "command": "oric-debug.openSymbols",
                "title": "Oric: Symbol Browser"
            },
            {
                "command": "oric-debug.reparseAnnotations",
                "title": "Oric: Reparse Annotations (no rebuild)"
            },
            {
                "command": "oric-debug.reloadSymbols",
                "title": "Oric: Reload Symbols (after byte-identical rebuild)"
            },
            {
                "command": "oric-debug.toggleBinary",
                "title": "Oric: Toggle Binary Column in Values"
            },
            {
                "command": "oric-debug.openDisassembly",
                "title": "Oric: Disassembly View"
            },
            {
                "command": "oric-debug.stepOverInstruction",
                "title": "Oric: Step Over (Instruction)"
            },
            {
                "command": "oric-debug.stepIntoInstruction",
                "title": "Oric: Step Into (Instruction)"
            },
            {
                "command": "oric-debug.showCurrentLocation",
                "title": "Oric: Show Current Location",
                "icon": "$(debug-stackframe)"
            },
            {
                "command": "oric-debug.turboRunToCursor",
                "title": "Oric: Turbo Run to Cursor",
                "icon": "$(run-all)"
            },
            {
                "command": "oric-debug.copyInstructionAnnotation",
                "title": "Oric: Copy Instruction Annotation"
            },
            {
                "command": "oric-debug.copyLine",
                "title": "Oric: Copy Line + Annotation"
            },
            {
                "command": "oric-debug.selectModule",
                "title": "Oric: Active Module"
            },
            {
                "command": "oric-debug.toggleStepMode",
                "title": "Oric: Toggle Step Granularity (Statement / Instruction)"
            },
            {
                "command": "oric-debug.selectLogLevel",
                "title": "Oric: Debug Log Level"
            },
            {
                "command": "oric-debug.runToLine",
                "title": "▶ Run to This Line"
            },
            {
                "command": "oric-debug.turboRunToLine",
                "title": "⚡ Turbo Run to This Line"
            },
            {
                "command": "oric-debug.jumpToLine",
                "title": "⌖ Jump to This Line"
            },
            {
                "command": "oric-debug.skipLine",
                "title": "↷ Skip This Line"
            },
            {
                "command": "osdk.xaReference",
                "title": "OSDK: XA Quick Reference"
            },
            {
                "command": "osdk.6502Reference",
                "title": "OSDK: 6502 Opcode Reference"
            }
        ],
        "keybindings": [
            {
                "command": "oric-debug.skipInstruction",
                "key": "ctrl+shift+f12",
                "when": "debugType == 'oric-debug' && debugState == 'stopped'"
            },
            {
                "command": "oric-debug.toggleWarp",
                "key": "ctrl+shift+f6",
                "when": "debugType == 'oric-debug'"
            },
            {
                "command": "oric-debug.resetCycleCounter",
                "key": "ctrl+shift+f9",
                "when": "debugType == 'oric-debug' && debugState == 'stopped'"
            },
            {
                "command": "oric-debug.showCurrentLocation",
                "key": "ctrl+alt+home",
                "when": "debugType == 'oric-debug' && debugState == 'stopped'"
            },
            {
                "command": "oric-debug.stepOverInstruction",
                "key": "f10",
                "when": "oricInstructionStepMode && debugType == 'oric-debug' && debugState == 'stopped'"
            },
            {
                "command": "oric-debug.stepIntoInstruction",
                "key": "f11",
                "when": "oricInstructionStepMode && debugType == 'oric-debug' && debugState == 'stopped'"
            }
        ],
        "menus": {
            "view/title": [
                { "command": "oric-debug.bpEnableAll", "when": "view == oricBreakpoints", "group": "navigation@1" },
                { "command": "oric-debug.bpDisableAll", "when": "view == oricBreakpoints", "group": "navigation@2" },
                { "command": "oric-debug.snapshotSave", "when": "view == oricSnapshots", "group": "navigation@1" },
                { "command": "oric-debug.snapshotRefresh", "when": "view == oricSnapshots", "group": "navigation@2" }
            ],
            "view/item/context": [
                { "command": "oric-debug.snapshotRestoreItem", "when": "view == oricSnapshots && viewItem == oricSnap", "group": "inline@1" },
                { "command": "oric-debug.snapshotRenameItem", "when": "view == oricSnapshots && viewItem == oricSnap", "group": "inline@2" },
                { "command": "oric-debug.snapshotDeleteItem", "when": "view == oricSnapshots && viewItem == oricSnap", "group": "inline@3" },
                { "command": "oric-debug.snapshotRestoreItem", "when": "view == oricSnapshots && viewItem == oricSnap", "group": "1_snap@1" },
                { "command": "oric-debug.snapshotRenameItem", "when": "view == oricSnapshots && viewItem == oricSnap", "group": "1_snap@2" },
                { "command": "oric-debug.snapshotDeleteItem", "when": "view == oricSnapshots && viewItem == oricSnap", "group": "1_snap@3" },
                { "command": "oric-debug.bpEnableModule", "when": "view == oricBreakpoints && viewItem == oricModule", "group": "inline@1" },
                { "command": "oric-debug.bpDisableModule", "when": "view == oricBreakpoints && viewItem == oricModule", "group": "inline@2" },
                { "command": "oric-debug.bpEnableModule", "when": "view == oricBreakpoints && viewItem == oricModule", "group": "1_mod@1" },
                { "command": "oric-debug.bpDisableModule", "when": "view == oricBreakpoints && viewItem == oricModule", "group": "1_mod@2" },
                { "command": "oric-debug.bpEnableFile", "when": "view == oricBreakpoints && viewItem == oricFile", "group": "inline@1" },
                { "command": "oric-debug.bpDisableFile", "when": "view == oricBreakpoints && viewItem == oricFile", "group": "inline@2" },
                { "command": "oric-debug.bpEnableFile", "when": "view == oricBreakpoints && viewItem == oricFile", "group": "1_mod@1" },
                { "command": "oric-debug.bpDisableFile", "when": "view == oricBreakpoints && viewItem == oricFile", "group": "1_mod@2" },
                { "command": "oric-debug.bpEdit", "when": "view == oricBreakpoints && viewItem == oricBp", "group": "inline@1" },
                { "command": "oric-debug.bpRemove", "when": "view == oricBreakpoints && viewItem == oricBp", "group": "inline@2" },
                { "command": "oric-debug.bpEdit", "when": "view == oricBreakpoints && viewItem == oricBp", "group": "1_bp@1" },
                { "command": "oric-debug.bpRemove", "when": "view == oricBreakpoints && viewItem == oricBp", "group": "1_bp@2" },
                { "command": "oric-debug.bpEditDetail", "when": "view == oricBreakpoints && viewItem == oricBpDetail", "group": "inline@1" }
            ],
            "debug/toolBar": [
                {
                    "command": "oric-debug.skipInstruction",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                },
                {
                    "command": "oric-debug.warpOn",
                    "when": "debugType == 'oric-debug' && !oric-debug.warp"
                },
                {
                    "command": "oric-debug.warpOff",
                    "when": "debugType == 'oric-debug' && oric-debug.warp"
                },
                {
                    "command": "oric-debug.resetCycleCounter",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                },
                {
                    "command": "oric-debug.showCurrentLocation",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                },
                {
                    "command": "oric-debug.turboRunToCursor",
                    "when": "debugType == 'oric-debug' && debugState == 'stopped'"
                }
            ],
            "editor/lineNumber/context": [
                {
                    "command": "oric-debug.runToLine",
                    "group": "oric@1",
                    "when": "inDebugMode && debugType == 'oric-debug' && debugState == 'stopped' && resourceScheme == 'file' && editorLineNumber not in oric-debug.pcEditorLines"
                },
                {
                    "command": "oric-debug.turboRunToLine",
                    "group": "oric@2",
                    "when": "inDebugMode && debugType == 'oric-debug' && debugState == 'stopped' && resourceScheme == 'file' && editorLineNumber not in oric-debug.pcEditorLines"
                },
                {
                    "command": "oric-debug.jumpToLine",
                    "group": "oric@3",
                    "when": "inDebugMode && debugType == 'oric-debug' && debugState == 'stopped' && resourceScheme == 'file' && editorLineNumber not in oric-debug.pcEditorLines"
                },
                {
                    "command": "oric-debug.skipLine",
                    "group": "oric@4",
                    "when": "inDebugMode && debugType == 'oric-debug' && debugState == 'stopped' && resourceScheme == 'file' && editorLineNumber in oric-debug.pcEditorLines"
                },
                {
                    "command": "oric-debug.copyLine",
                    "group": "oric@5",
                    "when": "inDebugMode && debugType == 'oric-debug' && resourceScheme == 'file'"
                }
            ],
            "commandPalette": [
                {
                    "command": "oric-debug.bpEnableModule",
                    "when": "false"
                },
                {
                    "command": "oric-debug.bpDisableModule",
                    "when": "false"
                },
                {
                    "command": "oric-debug.bpEnableFile",
                    "when": "false"
                },
                {
                    "command": "oric-debug.bpDisableFile",
                    "when": "false"
                },
                {
                    "command": "oric-debug.runToLine",
                    "when": "false"
                },
                {
                    "command": "oric-debug.turboRunToLine",
                    "when": "false"
                },
                {
                    "command": "oric-debug.jumpToLine",
                    "when": "false"
                },
                {
                    "command": "oric-debug.skipLine",
                    "when": "false"
                }
            ]
        },
        "debuggers": [
            {
                "type": "oric-debug",
                "label": "Oric Debug",
                "program": "./debug_adapter.js",
                "runtime": "node",
                "configurationAttributes": {
                    "attach": {
                        "required": ["port"],
                        "properties": {
                            "host": {
                                "type": "string",
                                "description": "Hostname of the Oricutron GDB stub",
                                "default": "localhost"
                            },
                            "port": {
                                "type": "number",
                                "description": "TCP port of the Oricutron GDB stub",
                                "default": 6502
                            },
                            "symbolFile": {
                                "type": "string",
                                "description": "Path to symbol file (HHHH symbol_name per line)"
                            },
                            "stopOnAttach": {
                                "type": "boolean",
                                "description": "Break on attach",
                                "default": true
                            },
                            "logLevel": {
                                "type": "number",
                                "description": "Debug log verbosity: 0=errors, 1=normal, 2=verbose",
                                "default": 1
                            }
                        }
                    },
                    "launch": {
                        "required": ["emulatorPath", "diskImage"],
                        "properties": {
                            "emulatorPath": {
                                "type": "string",
                                "description": "Path to Oricutron executable"
                            },
                            "emulatorArgs": {
                                "type": "array",
                                "items": { "type": "string" },
                                "description": "Additional emulator arguments",
                                "default": []
                            },
                            "diskImage": {
                                "type": "string",
                                "description": "Disk image to load (.dsk or .tap)"
                            },
                            "emulatorCwd": {
                                "type": "string",
                                "description": "Working directory for emulator (defaults to emulator's directory)"
                            },
                            "host": {
                                "type": "string",
                                "description": "Hostname for GDB connection",
                                "default": "localhost"
                            },
                            "port": {
                                "type": "number",
                                "description": "TCP port for Oricutron GDB stub",
                                "default": 6502
                            },
                            "symbolFile": {
                                "type": "string",
                                "description": "Path to symbol file (HHHH symbol_name per line)"
                            },
                            "stopOnAttach": {
                                "type": "boolean",
                                "description": "Break on attach",
                                "default": true
                            },
                            "logLevel": {
                                "type": "number",
                                "description": "Debug log verbosity: 0=errors, 1=normal, 2=verbose",
                                "default": 1
                            },
                            "turboRunTo": {
                                "type": "string",
                                "description": "Symbol to warp (max-speed) fast-forward to on launch, e.g. a game or module entry label"
                            },
                            "build": {
                                "type": "object",
                                "description": "Optional build configuration (staleness check + build)",
                                "properties": {
                                    "command": {
                                        "type": "string",
                                        "description": "Build command (e.g. osdk_build.bat)"
                                    },
                                    "cwd": {
                                        "type": "string",
                                        "description": "Working directory for build command"
                                    },
                                    "output": {
                                        "type": "string",
                                        "description": "Build output file to check for staleness"
                                    },
                                    "sources": {
                                        "type": "array",
                                        "items": { "type": "string" },
                                        "description": "Source directories/files to check for staleness"
                                    }
                                }
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "oric-debug",
                        "request": "launch",
                        "name": "Build & Debug",
                        "emulatorPath": "${env:OSDK}/Oricutron/Oricutron.exe",
                        "diskImage": "${workspaceFolder}/build/program.dsk",
                        "port": 6502,
                        "symbolFile": "${workspaceFolder}/build/symbols",
                        "stopOnAttach": true,
                        "build": {
                            "command": "osdk_build.bat",
                            "cwd": "${workspaceFolder}",
                            "output": "${workspaceFolder}/build/program.dsk",
                            "sources": ["${workspaceFolder}/code"]
                        }
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "Oric Debug: Build & Launch",
                        "description": "Build if stale, launch Oricutron, and attach debugger",
                        "body": {
                            "type": "oric-debug",
                            "request": "launch",
                            "name": "Build & Debug",
                            "emulatorPath": "^\"\\${env:OSDK}/Oricutron/Oricutron.exe\"",
                            "diskImage": "^\"\\${workspaceFolder}/build/${1:program}.dsk\"",
                            "port": 6502,
                            "symbolFile": "^\"\\${workspaceFolder}/build/symbols\"",
                            "stopOnAttach": true,
                            "build": {
                                "command": "osdk_build.bat",
                                "cwd": "^\"\\${workspaceFolder}\"",
                                "output": "^\"\\${workspaceFolder}/build/${1:program}.dsk\"",
                                "sources": ["^\"\\${workspaceFolder}/code\""]
                            }
                        }
                    },
                    {
                        "label": "Oric Debug: Attach",
                        "description": "Attach to a running Oricutron instance with GDB stub enabled",
                        "body": {
                            "type": "oric-debug",
                            "request": "attach",
                            "name": "Attach to Oricutron",
                            "host": "localhost",
                            "port": 6502,
                            "symbolFile": "^\"\\${workspaceFolder}/build/symbols\"",
                            "stopOnAttach": true
                        }
                    }
                ]
            }
        ]
    }
}
