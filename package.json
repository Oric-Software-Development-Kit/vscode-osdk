{
    "name": "osdk-debug",
    "displayName": "OSDK",
    "description": "Oric Software Development Kit - 6502/XA assembly highlighting and Oricutron debugging",
    "version": "0.0.49",
    "publisher": "dbug",
    "license": "MIT",
    "icon": "images/oric-icon.png",
    "homepage": "https://osdk.org",
    "repository": {
        "type": "git",
        "url": "https://github.com/Oric-Software-Development-Kit/vscode-osdk"
    },
    "bugs": {
        "url": "https://github.com/Oric-Software-Development-Kit/vscode-osdk/issues"
    },
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Debuggers",
        "Programming Languages"
    ],
    "keywords": [
        "osdk",
        "6502",
        "65C02",
        "oric",
        "oricutron"
    ],
    "activationEvents": [
        "onDebugResolve:oric-debug",
        "onLanguage:osdk",
        "onWebviewPanel:oricHeatmap",
        "onWebviewPanel:oricScreenView",
        "onWebviewPanel:oricSymbols",
        "onWebviewPanel:oricMemoryMap",
        "onWebviewPanel:oricDisassembly",
        "onWebviewPanel:oricMemory"
    ],
    "main": "./extension.js",
    "configurationDefaults": {
        "files.associations": {
            "*.s": "osdk",
            "*.asm": "osdk"
        },
        "cSpell.words": [
            "ACIA", "Arkos", "Atmos",
            "endif", "elif", "elseif", "ifdef", "ifndef", "undef",
            "Chema", "Cumana", "Cumulus",
            "Defence", "DDENS", "DDRA", "DDRB", "DRQ",
            "EPROM", "Erebus", "Euphoric",
            "HIRES", "INTRQ", "IRQ",
            "Jasmin", "Loci", "LORES",
            "Microdisc", "NMI", "NOTRDY",
            "ORA2", "ORB", "Oric", "Oricutron", "osdk", "OSDK",
            "PCR", "PSG", "ROMDIS", "RST",
            "Sedoric", "Stratsed",
            "Telestrat", "Twilight",
            "VIA", "WRPROT", "WRTERR"
        ]
    },
    "contributes": {
        "configuration": {
            "title": "Oric Debug",
            "properties": {
                "oric-debug.showBinary": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show the %binary column in decoded values (e.g. $02|2|%00000010). Turn off for a compact $02|2. Applies live to a running debug session."
                },
                "oric-debug.breakpointsFollowActiveModule": {
                    "type": "boolean",
                    "default": true,
                    "description": "In the Oric Breakpoints panel, expand the active overlay module's section and collapse the others as the active module changes. The active module is always highlighted regardless of this setting."
                },
                "oric-debug.colorSourceFilesByType": {
                    "type": "boolean",
                    "default": true,
                    "description": "Tint file-name labels (editor tabs and Explorer) by type: C source (.c) green, headers (.h) teal, assembler (.s/.asm) blue, automation scripts (.js) violet. Colors are the oric.* theme colors (override them in workbench.colorCustomizations)."
                }
            }
        },
        "colors": [
            {
                "id": "oric.cFileColor",
                "description": "Label tint for C source files (.c) in tabs/Explorer.",
                "defaults": { "dark": "#73c990", "light": "#2ea043", "highContrast": "#73c990", "highContrastLight": "#2ea043" }
            },
            {
                "id": "oric.headerFileColor",
                "description": "Label tint for header files (.h — shared by C and assembler) in tabs/Explorer. Muted gray: headers are just declarations.",
                "defaults": { "dark": "#9d9d9d", "light": "#6e6e6e", "highContrast": "#9d9d9d", "highContrastLight": "#6e6e6e" }
            },
            {
                "id": "oric.asmFileColor",
                "description": "Label tint for assembler files (.s/.asm) in tabs/Explorer.",
                "defaults": { "dark": "#6cb6ff", "light": "#0969da", "highContrast": "#6cb6ff", "highContrastLight": "#0969da" }
            },
            {
                "id": "oric.scriptFileColor",
                "description": "Label tint for automation scripts (.js) in tabs/Explorer. Violet, kept clear of git-modified orange.",
                "defaults": { "dark": "#c586c0", "light": "#8250df", "highContrast": "#c586c0", "highContrastLight": "#8250df" }
            }
        ],
        "languages": [
            {
                "id": "osdk",
                "aliases": ["OSDK"],
                "extensions": [".asm", ".s"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "osdk",
                "scopeName": "source.asm.6502_65816.osdk",
                "path": "./syntaxes/osdk.tmLanguage.json"
            }
        ],
        "breakpoints": [
            { "language": "osdk" }
        ],
        "viewsContainers": {
            "panel": [
                {
                    "id": "oricDebugPanel",
                    "title": "Oric Debug",
                    "icon": "images/oric-icon.png"
                }
            ]
        },
        "views": {
            "debug": [
                {
                    "id": "oricDebugControls",
                    "name": "Oric Debug Controls",
                    "type": "webview",
                    "icon": "images/oric.svg"
                },
                {
                    "id": "oricCpuRegs",
                    "name": "Oric Registers",
                    "type": "webview",
                    "icon": "images/oric.svg"
                },
                {
                    "id": "oricPeripherals",
                    "name": "Oric Peripherals",
                    "type": "webview",
                    "icon": "images/oric.svg"
                },
                {
                    "id": "oricBreakpoints",
                    "name": "Oric Breakpoints",
                    "icon": "images/oric.svg"
                },
                {
                    "id": "oricSnapshots",
                    "name": "Oric Snapshots",
                    "icon": "images/oric.svg"
                },
                {
                    "id": "oricAutomation",
                    "name": "Oric Automation",
                    "icon": "images/oric.svg"
                },
                {
                    "id": "oricDocs",
                    "name": "Oric Documentation",
                    "icon": "images/oric.svg"
                }
            ],
            "oricDebugPanel": [
                {
                    "id": "oricCurrentInstr",
                    "name": "Current Instruction",
                    "type": "webview",
                    "icon": "images/oric.svg"
                }
            ]
        },
        "commands": [
            {
