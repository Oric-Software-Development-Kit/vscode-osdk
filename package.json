                "command": "oric-debug.snapshotRefresh",
                "title": "Oric: Refresh Snapshots",
                "icon": "$(refresh)"
            },
            {
                "command": "oric-debug.snapshotOpenFolder",
                "title": "Oric: Open Snapshots Folder",
                "icon": "$(folder-opened)"
            },
            {
                "command": "oric-debug.automationOpenFolder",
                "title": "Oric: Open Automation Folder",
                "icon": "$(folder-opened)"
            },
            {
                "command": "oric-debug.snapshotRestoreItem",
